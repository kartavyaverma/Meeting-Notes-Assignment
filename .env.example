# Copy to .env and fill in. Never commit .env.

# Google AI Studio -> Get API key
GEMINI_API_KEY=your-gemini-api-key-here

# Notion -> Developer tools -> Connections -> your connection -> Access token (starts with ntn_)
NOTION_TOKEN=your-notion-integration-secret-here

# The ID of the Notion database the notes go into (32-character hex string from the database URL)
NOTION_DATABASE_ID=your-database-id-here

# Optional: the Gemini model to call. Leave blank for the default, gemini-3.8-flash.
GEMINI_MODEL=

# Optional: Gemini 3.8 Flash paid-tier prices in USD per 1M tokens (ai.google.dev/gemini-api/docs/pricing).
# When set, each run prints its cost. Thinking tokens are billed at the output price.
# These rates apply through 2026-12-31; Google doubles them from 2027-01-01 (1.50 / 7.50).
GEMINI_INPUT_USD_PER_M=0.75
GEMINI_OUTPUT_USD_PER_M=3.75
